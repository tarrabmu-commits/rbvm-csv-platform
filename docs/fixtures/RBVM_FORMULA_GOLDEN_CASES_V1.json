  "orderingRelations": [
    {
      "left": "GC-CVSS-HIGH",
      "relation": "GREATER_THAN",
      "right": "GC-CVSS-LOW",
      "basis": "technical severity material sensitivity with all other Formula-relevant semantics equal"
    },
    {
      "left": "GC-KEV-LISTED",
      "relation": "GREATER_THAN",
      "right": "GC-KEV-NOT-LISTED",
      "basis": "known exploitation material sensitivity with all other Formula-relevant semantics equal"
    },
    {
      "left": "GC-EPSS-HIGH",
      "relation": "GREATER_THAN",
      "right": "GC-EPSS-LOW",
      "basis": "higher EPSS probability must materially increase the exploitation-likelihood contribution in a non-saturated synthetic case"
    },
    {
      "left": "GC-CRITICALITY-MISSION",
      "relation": "GREATER_THAN",
      "right": "GC-CRITICALITY-LOW",
      "basis": "customer-confirmed business criticality material sensitivity"
    },
    {
      "left": "GC-REACHABILITY-REACHABLE",
      "relation": "GREATER_THAN",
      "right": "GC-REACHABILITY-NOT-REACHABLE",
      "basis": "same exact linked target changes only native reachability status"
    },
    {
      "left": "GC-IMPACT-SEVERE",
      "relation": "GREATER_THAN",
      "right": "GC-IMPACT-LOW",
      "basis": "same service and impact dimension changes only customer impact level"
    },
    {
      "left": "GC-PERCENTILE-A",
      "relation": "EQUAL_TO",
      "right": "GC-PERCENTILE-B",
      "basis": "EPSS percentile is excluded from Formula V1 arithmetic when probability is identical"
    },
    {
      "left": "GC-ENVIRONMENT-PRODUCTION",
      "relation": "EQUAL_TO",
      "right": "GC-ENVIRONMENT-DEVELOPMENT",
      "basis": "Environment is Formula V1 context/explanation only when Business Criticality and all other Formula-relevant evidence are identical"
    },
    {
      "left": "GC-OWNER-A",
      "relation": "EQUAL_TO",
      "right": "GC-OWNER-B",
      "basis": "Business Owner is Formula V1 context/explanation only"
    },
    {
      "left": "GC-ALL-ADVERSE",
      "relation": "GREATER_THAN",
      "right": "GC-BASE-COMPUTABLE",
      "basis": "dominance case: multiple Formula-relevant dimensions move to materially more adverse valid values without any compensating improvement"
    },
    {
      "left": "GC-CRITICAL-NOT-LISTED-LOW-EPSS",
      "relation": "UNORDERED_BY_READINESS",
      "right": "GC-MEDIUM-KEV-HIGH-EPSS",
      "basis": "technical severity trades off against known exploitation and exploitation probability; Stage 8 must not smuggle weights"
    },
    {
      "left": "GC-HIGH-TECH-LOW-IMPACT-ISOLATED",
      "relation": "UNORDERED_BY_READINESS",
      "right": "GC-LOWER-TECH-MISSION-REACHABLE",
      "basis": "technical severity trades off against criticality, reachability, and impact; ordering belongs to Formula V1"
    }
  ],
  "historicalReplayCases": [
    {
      "id": "GR-HISTORICAL-ASOF-LINK",
      "rule": "A later scanner-managed-asset or Finding-context association revision cannot change the result identity of an already materialized historical Decision Input snapshot."
    },
    {
      "id": "GR-HISTORICAL-EVIDENCE",
      "rule": "Later native evidence cannot replace exact evidence references retained by a historical Decision Input snapshot."
    },
    {
      "id": "GR-FORMULA-IDENTITY",
      "rule": "Changing Formula version or Formula SHA creates a distinct Risk Result identity even when the Decision Input and displayed numeric value happen to match."
    },
    {
      "id": "GR-PRIORITY-INDEPENDENCE",
      "rule": "Changing Priority, Treatment, or SLA policy cannot change the underlying historical Risk Result identity."
    },
    {
      "id": "GR-EXACT-REPLAY",
      "rule": "Exact Decision Input plus exact Formula identity must reproduce byte-equivalent canonical result and explanation semantics."
    }
  ]
}
