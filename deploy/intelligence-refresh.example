# The umbrella refresh derives its CVE set from the current canonical Cases API.
RBVM_API_BASE_URL=http://127.0.0.1:8080
# Set only when the API endpoint requires authentication. The umbrella credential is reused by
# the canonical CVE read and all three HTTP importers unless a narrower source-specific key is set.
# RBVM_INTELLIGENCE_API_KEY=from-a-secret-manager
# RBVM_CVSS_API_KEY=optional-source-specific-override
# RBVM_EPSS_API_KEY=optional-source-specific-override
# RBVM_KEV_API_KEY=optional-source-specific-override

RBVM_INTELLIGENCE_WORK_DIR=/var/lib/rbvm-platform/canonical-intelligence-refresh

RBVM_CVSS_OUTPUT_DIR=/var/lib/rbvm-platform/cvss-v31
RBVM_CVSS_CACHE_DIR=/var/cache/rbvm-platform/cvss-v31
RBVM_CVSS_KEEP=14
RBVM_CVSS_OFFLINE=false

RBVM_EPSS_OUTPUT_DIR=/var/lib/rbvm-platform/epss
RBVM_EPSS_KEEP=14

RBVM_KEV_OUTPUT_DIR=/var/lib/rbvm-platform/cisa-kev
RBVM_KEV_KEEP=14

# NVD_API_KEY is optional. When present it is sent only in the NVD apiKey header.
# NVD_API_KEY=from-a-secret-manager
