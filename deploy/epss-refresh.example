# Source-only systemd refresh derives CVEs from the current canonical Cases API.
RBVM_API_BASE_URL=http://127.0.0.1:8080

# The supplied user service is sandboxed for the default per-user work/output paths.
# Leave RBVM_INTELLIGENCE_WORK_DIR and RBVM_EPSS_OUTPUT_DIR unset unless you also update
# the service ReadWritePaths for your chosen locations.
RBVM_EPSS_KEEP=14

# Optional only for a hardened/authenticated API deployment. The source-specific key wins;
# otherwise RBVM_INTELLIGENCE_API_KEY can be shared with the canonical CVE read.
# RBVM_INTELLIGENCE_API_KEY=from-a-secret-manager
# RBVM_EPSS_API_KEY=optional-source-specific-override

# Optional bound for the canonical EPSS_CSV_V1 handoff (default 32 MiB).
RBVM_EPSS_MAX_BYTES=33554432

# Optional controlled replay/testing input. Leave unset in normal production operation.
# The local gzip is parsed through the same FIRST feed validation path; semantic source
# remains the pinned official daily EPSS bulk feed.
# RBVM_EPSS_OFFLINE_INPUT=/absolute/path/to/epss_scores-current.csv.gz
