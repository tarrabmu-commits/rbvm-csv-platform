# Current vulnerability CSV containing CVE_ID. Must be a regular non-symlink file.
RBVM_EPSS_INPUT=/var/lib/rbvm-platform/current-wazuh-v1.csv

# Immutable refresh snapshots default to:
#   $HOME/.local/share/rbvm-platform/epss
# Leave RBVM_EPSS_OUTPUT_DIR unset when using the supplied user service, or change the
# service ReadWritePaths setting if you intentionally choose another protected path.
RBVM_EPSS_KEEP=14

# Local default: no access token is required when the platform runs with RBVM_AUTH_MODE=DISABLED.
RBVM_API_BASE_URL=http://127.0.0.1:8080

# Optional only for a hardened/authenticated API deployment.
# RBVM_EPSS_API_KEY=from-a-secret-manager

# Optional bound for the canonical EPSS_CSV_V1 handoff (default 32 MiB).
RBVM_EPSS_MAX_BYTES=33554432

# Optional controlled replay/testing input. Leave unset in normal production operation.
# The local gzip is parsed through the same FIRST feed validation path; semantic source
# remains the pinned official daily EPSS bulk feed.
# RBVM_EPSS_OFFLINE_INPUT=/absolute/path/to/epss_scores-current.csv.gz
