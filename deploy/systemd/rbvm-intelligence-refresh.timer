[Unit]
Description=Daily RBVM canonical vulnerability intelligence refresh schedule
Conflicts=rbvm-cvss-v31-refresh.timer rbvm-epss-refresh.timer rbvm-cisa-kev-refresh.timer

[Timer]
OnCalendar=daily
RandomizedDelaySec=30m
Persistent=true
Unit=rbvm-intelligence-refresh.service

[Install]
WantedBy=timers.target
