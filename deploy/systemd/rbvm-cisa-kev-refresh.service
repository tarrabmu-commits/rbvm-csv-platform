[Unit]
Description=RBVM canonical-CVE CISA KEV refresh
After=network-online.target rbvm-csv-platform.service
Wants=network-online.target rbvm-csv-platform.service

[Service]
Type=oneshot
WorkingDirectory=%h/rbvm-csv-platform
EnvironmentFile=%h/.config/rbvm-platform/cisa-kev-refresh.env
# The canonical wrapper exports current Cases, then delegates to scheduled-cisa-kev-refresh.sh.
ExecStart=/usr/bin/env bash %h/rbvm-csv-platform/scripts/scheduled-canonical-source-refresh.sh kev
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=-%h/.local/share/rbvm-platform/canonical-intelligence-refresh
ReadWritePaths=-%h/.local/share/rbvm-platform/cisa-kev
