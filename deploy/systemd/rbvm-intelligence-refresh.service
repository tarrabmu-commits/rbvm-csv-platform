[Unit]
Description=RBVM vulnerability intelligence refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/rbvm-csv-platform
EnvironmentFile=%h/.config/rbvm-platform/intelligence-refresh.env
ExecStart=%h/rbvm-csv-platform/scripts/scheduled-intelligence-refresh.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
