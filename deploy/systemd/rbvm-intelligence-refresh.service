[Unit]
Description=RBVM canonical vulnerability intelligence refresh
After=network-online.target rbvm-csv-platform.service
Wants=network-online.target rbvm-csv-platform.service

[Service]
Type=oneshot
WorkingDirectory=%h/rbvm-csv-platform
EnvironmentFile=%h/.config/rbvm-platform/intelligence-refresh.env
ExecStart=%h/rbvm-csv-platform/scripts/scheduled-canonical-intelligence-refresh.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=-%h/.local/share/rbvm-platform/canonical-intelligence-refresh
ReadWritePaths=-%h/.local/share/rbvm-platform/cvss-v31
ReadWritePaths=-%h/.cache/rbvm-platform/cvss-v31
ReadWritePaths=-%h/.local/share/rbvm-platform/epss
ReadWritePaths=-%h/.local/share/rbvm-platform/cisa-kev
