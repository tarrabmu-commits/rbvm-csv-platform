[Unit]
Description=RBVM canonical-CVE FIRST EPSS refresh
After=network-online.target rbvm-csv-platform.service
Wants=network-online.target rbvm-csv-platform.service

[Service]
Type=oneshot
WorkingDirectory=%h/rbvm-csv-platform
EnvironmentFile=%h/.config/rbvm-platform/epss-refresh.env
ExecStart=/usr/bin/env bash %h/rbvm-csv-platform/scripts/scheduled-canonical-source-refresh.sh epss
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=-%h/.local/share/rbvm-platform/canonical-intelligence-refresh
ReadWritePaths=-%h/.local/share/rbvm-platform/epss
UMask=0077
