# Source-only systemd refresh derives CVEs from the current canonical Cases API.
RBVM_API_BASE_URL=http://127.0.0.1:8080
RBVM_INTELLIGENCE_WORK_DIR=/var/lib/rbvm-platform/canonical-intelligence-refresh

RBVM_CVSS_OUTPUT_DIR=/var/lib/rbvm-platform/cvss-v31
RBVM_CVSS_CACHE_DIR=/var/cache/rbvm-platform/cvss-v31
RBVM_CVSS_KEEP=14
RBVM_CVSS_OFFLINE=false

# Optional only for a hardened/authenticated API deployment. The source-specific key wins;
# otherwise RBVM_INTELLIGENCE_API_KEY can be shared with the canonical CVE read.
# RBVM_INTELLIGENCE_API_KEY=from-a-secret-manager
# RBVM_CVSS_API_KEY=optional-source-specific-override

# Optional bound for the generated evidence handoff (default 16 MiB).
RBVM_CVSS_MAX_BYTES=16777216

# NVD_API_KEY is optional and is sent only to the official NVD apiKey header.
# NVD_API_KEY=from-a-secret-manager
